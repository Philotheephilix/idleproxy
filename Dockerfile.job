# Tier-1 job image — SPEC.md §5/§6. Every Codex-equivalent tool-enabled job
# runs here: fresh container per job, no host bind mounts except a
# read-only credential copy, egress locked to the model API host.
FROM node:22-slim

# bubblewrap: required for CLAUDE_CODE_SUBPROCESS_ENV_SCRUB (SPEC.md §5/§6)
# — without it the CLI refuses to start rather than silently skipping
# subprocess isolation. socat: Claude Code's own Bash-tool sandbox needs it
# too, independent of the env-scrub feature above.
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap socat && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g @anthropic-ai/claude-code && \
    groupadd -g 10001 ipxjob && \
    useradd -u 10001 -g ipxjob -m -s /usr/sbin/nologin ipxjob

USER ipxjob
WORKDIR /work

ENTRYPOINT ["claude"]
